{
  "name": "@opensu/ui",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Liquid Glass components for React, on Base UI (the phone drawer on Vaul).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/boundary-check.mjs && node --experimental-strip-types --no-warnings --test test/spring-test.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "vaul": "1.1.2"
  }
}
