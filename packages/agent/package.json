{
  "name": "@opensu/agent",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./starter": {
      "types": "./dist/starter.d.ts",
      "import": "./dist/starter.js"
    },
    "./templates-meta": {
      "types": "./dist/templates/meta.d.ts",
      "import": "./dist/templates/meta.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "starter": "tsx scripts/starter.ts"
  },
  "dependencies": {
    "@opensu/model": "workspace:*",
    "@tanstack/ai": "1.4.0",
    "@tanstack/ai-openai": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
