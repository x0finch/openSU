{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opensu-web",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": {
    "enabled": true
  },
  // Task 026: the prerendered pages are static assets, served before the
  // Worker runs; these paths go through the Worker first so that a request
  // on another host (the workers.dev address) gets the 308 to SITE_URL.
  // On the canonical host the Worker hands them straight to ASSETS. Scripts,
  // styles and images stay asset-only (no Worker request, no CPU).
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/studio", "/studio.html", "/projects", "/projects.html", "/auth-done", "/auth-done.html"]
  },
  // Accounts and the daily quota (task 019; migrations in ./migrations).
  // `database_id` is a placeholder for local runs; the deploy workflow
  // (scripts/d1-ensure.mjs) finds or creates the database by name and
  // writes its real id here before building. Self-hosters without D1:
  // remove this block and set QUOTA_ENABLED=false.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opensu",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
